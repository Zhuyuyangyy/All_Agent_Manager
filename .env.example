# ═══════════════════════════════════════════════════════════════════
# All-Agent Manager 配置
# ═══════════════════════════════════════════════════════════════════

# ── OpenClaw Gateway ─────────────────────────────────────────────
OPENCLAW_URL=http://127.0.0.1:18789/run-task

# ── OpenHanako ───────────────────────────────────────────────────
# 端口：优先读取 OPENHANAKO_PORT / HANA_PORT 环境变量
# 其次读取 ~/.openhanako/server-info.json
# 最后使用默认端口 12306
OPENHANAKO_HOST=localhost
OPENHANAKO_PORT=12306
# OPENHANAKO_API_KEY=

# ── Hermes ───────────────────────────────────────────────────────
HERMES_URL=http://127.0.0.1:8102/run-task
HERMES_CLI_COMMAND=python D:/GITHUB/hermes-agent-2026.4.16/main.py run-task
HERMES_BUSY_FILE=D:/GITHUB/hermes-agent-2026.4.16/runtime/hermes.busy
HERMES_BUSY_STALE_SECONDS=120

# ── Task Scheduler ──────────────────────────────────────────────
WAITING_TASK_SCAN_SECONDS=3

# ── iliya (Orchestrator Agent) ──────────────────────────────────
ILIYA_WORKSPACE=
ILIYA_ALLOW_SHELL=false

# ── MCP Storage ──────────────────────────────────────────────────
MCP_STORAGE_DIR=storage

# ── MiniMax MCP (可选) ──────────────────────────────────────────
# MINIMAX_API_KEY=

# ── Server ───────────────────────────────────────────────────────
# 默认端口 8000
# uvicorn backend.app:app --reload --port 8000
